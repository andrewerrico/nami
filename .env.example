# Copy to .env and fill in. .env is gitignored; this file is not.
# Every variable here is validated at boot by src/core/env.ts — a missing or
# malformed value stops the process immediately and names the variable.

# --- Discord -----------------------------------------------------------------
# Bot token. Discord Developer Portal → your app → Bot → Reset Token.
# Secret. If it leaks, reset it there immediately.
DISCORD_TOKEN=

# Application (client) ID. Needed to register slash commands. Not secret.
DISCORD_APPLICATION_ID=

# Optional. Your server's ID (right-click the server -> Copy Server ID, with
# Developer Mode on). When set, `pnpm register` publishes commands to just this
# guild, where they appear instantly. Leave blank to register globally, which
# can take up to an hour to propagate. Not secret.
DISCORD_GUILD_ID=

# --- Database ----------------------------------------------------------------
# Supabase → Project Settings → Database → Connection string.
# Use the *Session pooler* URI on port 5432, NOT the direct connection: the
# direct host is IPv6-only on the free tier, and transaction mode (6543)
# breaks prepared statements. See ROADMAP.md §7.
DATABASE_URL=

# --- Runtime -----------------------------------------------------------------
# development | test | production. Defaults to development.
# development also switches logging to human-readable output via pino-pretty.
NODE_ENV=development

# trace | debug | info | warn | error | fatal. Defaults to info.
LOG_LEVEL=debug
