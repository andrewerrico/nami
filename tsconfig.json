{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",

    /* Strictness. CLAUDE.md requires strict mode; these go beyond it. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,

    /* ESM hygiene. verbatimModuleSyntax forces `import type` to be explicit,
       which keeps type-only imports from surviving into emitted JS. */
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["src", "scripts", "test", "drizzle.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "legacy"]
}
